<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Zorunlu standart paket anahtarları (build ayarlarından türer) -->
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>

  <key>CFBundleDisplayName</key>
  <string>cheesino</string>

  <!-- Export compliance: yalnız standart HTTPS/şifreleme kullanılır → muaf.
       Bu anahtar her TestFlight/App Store yüklemesinde şifreleme sorusunu atlatır. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- KRİTİK: IPTV portallarının çoğu düz HTTP. Native'de mixed-content duvarı yok,
       ancak App Transport Security HTTP'yi varsayılan engeller. Bu istisna yayınların
       oynamasını sağlar (PWA'daki asıl tıkanmayı çözen ayar). Mağaza incelemesinde
       "kullanıcı kendi IPTV kaynağını getirir; HTTP portal desteği gerekir" gerekçesi verilir. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>

  <!-- Arka planda ses (canlı yayın/radyo arka planda sürer) + PiP AVKit ile gelir. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>

  <!-- Yerel ağdaki portallar için (opsiyonel, iOS 14+ local network izni). -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Yerel ağdaki IPTV sunucularına bağlanmak için.</string>

  <key>UILaunchScreen</key>
  <dict/>

  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict>
</plist>
