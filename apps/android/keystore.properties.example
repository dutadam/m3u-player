# Yayın imzalama anahtarı — bu dosyayı `keystore.properties` olarak kopyala ve doldur.
# GERÇEK keystore.properties ASLA commit edilmez (.gitignore'da).
#
# Upload anahtarı üret (bir kez):
#   keytool -genkey -v -keystore upload.jks -alias cheesino-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Play App Signing önerilir: bu yalnız "upload" anahtarıdır; Google dağıtım anahtarını
# kendi tutar, kaybolursa upload anahtarı sıfırlanabilir.

storeFile=upload.jks
storePassword=CHANGEME
keyAlias=cheesino-upload
keyPassword=CHANGEME
